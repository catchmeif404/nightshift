diff --git a/src/items.js b/src/items.js
index 3c456b8..b371d46 100644
--- a/src/items.js
+++ b/src/items.js
@@ -6,3 +6,10 @@ export function totalValue(items) {
 export function findByName(items, name) {
   return items.find((item) => item.name === name);
 }
+
+export function lowStock(items, threshold = 5) {
+  if (!Number.isInteger(threshold) || threshold < 0) throw new Error("invalid threshold");
+  return items
+    .filter((item) => item.qty <= threshold)
+    .sort((a, b) => a.qty - b.qty || (a.name < b.name ? -1 : a.name > b.name ? 1 : 0));
+}
diff --git a/test/cli.test.js b/test/cli.test.js
index cfb0e15..a9d5d42 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -11,3 +11,32 @@ test("total command", () => {
   writeFileSync(file, JSON.stringify([{ sku: "A1", name: "Bolt", qty: 2, price: 3 }]));
   assert.equal(run(["total", file]), "6");
 });
+
+function itemsFile() {
+  const dir = mkdtempSync(join(tmpdir(), "inv-"));
+  const file = join(dir, "items.json");
+  writeFileSync(
+    file,
+    JSON.stringify([
+      { sku: "A1", name: "Bolt", qty: 2, price: 3 },
+      { sku: "B2", name: "Nut", qty: 9, price: 1 },
+      { sku: "C3", name: "Screw", qty: 2, price: 1 },
+    ]),
+  );
+  return file;
+}
+
+test("low command", () => {
+  const file = itemsFile();
+  assert.equal(run(["low", file]), "A1 Bolt 2\nC3 Screw 2");
+  assert.equal(run(["low", file, "--threshold", "9"]), "A1 Bolt 2\nC3 Screw 2\nB2 Nut 9");
+  assert.equal(run(["low", file, "--threshold", "1"]), "");
+});
+
+test("low command errors", () => {
+  const file = itemsFile();
+  assert.throws(() => run(["low"]), { message: "usage: low <file> [--threshold N]" });
+  for (const args of [["--threshold"], ["--threshold", "x"], ["--threshold", "-1"], ["--threshold", "1.5"]]) {
+    assert.throws(() => run(["low", file, ...args]), { message: "invalid threshold" });
+  }
+});
