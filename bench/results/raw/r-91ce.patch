+test("lowStock sorts by qty then name and defaults to threshold 5", () => {
+  const input = [
+    { sku: "1", name: "b", qty: 5, price: 1 },
+    { sku: "2", name: "a", qty: 5, price: 1 },
+    { sku: "3", name: "z", qty: 0, price: 1 },
+    { sku: "4", name: "Q", qty: 6, price: 1 },
