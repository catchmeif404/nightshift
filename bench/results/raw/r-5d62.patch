+  if (command === "low") {
+    const usage = "usage: low <file> [--threshold N]";
+    if (file === undefined || file === "--threshold") throw new Error(usage);
+    const rest = argv.slice(2);
+    let threshold = 5;
+    if (rest.length > 0) {
+      if (rest[0] !== "--threshold" || rest.length > 2) throw new Error(usage);
